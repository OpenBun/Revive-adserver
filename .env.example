# Copy to .env and fill in values, or paste the same keys into EasyPanel → Environment.
# For EasyPanel, see easypanel.env.example and README.md.
# Process env vars (EasyPanel Environment) override this file.

# --- Database (use DATABASE_URL or the DB_* fields) ---
# DATABASE_URL=mysql://user:password@mysql-hostname:3306/revive
DB_TYPE=mysqli
# EasyPanel: use your MySQL service hostname, e.g. myproject_mysql (NOT "db")
DB_HOST=
DB_PORT=3306
DB_NAME=revive
DB_USER=revive
DB_PASSWORD=
DB_TABLE_PREFIX=rv_
DB_TABLE_TYPE=INNODB

# --- Admin account (used on first install only) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_LANGUAGE=en
# ADMIN_TIMEZONE=UTC

# --- Public hostname (no http://) ---
APP_HOSTNAME=
REQUIRE_SSL=0
SKIP_AUTO_INSTALL=0
