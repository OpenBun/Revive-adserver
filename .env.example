# Copy to .env and fill in values, or paste the same keys into EasyPanel → Environment.
# For EasyPanel, see easypanel.env.example and README.md (required variables listed there).
# Existing process env vars override values from .env.


# --- Database (use DATABASE_URL or the DB_* fields) ---
# DATABASE_URL=mysql://user:password@db-host:3306/revive
DB_TYPE=mysqli
DB_HOST=db
DB_PORT=3306
DB_NAME=revive
DB_USER=revive
DB_PASSWORD=changeme
DB_TABLE_PREFIX=rv_
DB_TABLE_TYPE=INNODB

# --- Admin account (used on first install only) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_EMAIL=admin@example.com
ADMIN_LANGUAGE=en
# ADMIN_TIMEZONE=UTC

# --- Public hostname (no http://). Paths default to /www/admin, /www/delivery, /www/images ---
APP_HOSTNAME=localhost
# Or set full Revive webpaths explicitly:
# WEBPATH_ADMIN=localhost/www/admin
# WEBPATH_DELIVERY=localhost/www/delivery
# WEBPATH_IMAGES=localhost/www/images

REQUIRE_SSL=0

# Set to 1 to skip automatic CLI install (use the web installer instead)
SKIP_AUTO_INSTALL=0
